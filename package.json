{
  "name": "tournament-scheduler",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "web",
    "frontend",
    "packages/contracts"
  ],
  "scripts": {
    "build": "npm run build --prefix packages/contracts && npm run build --prefix web && npm run build --prefix frontend",
    "typecheck": "npm run typecheck --prefix web && npm run typecheck --prefix frontend",
    "test:unit": "jest --config jest.config.js --runInBand && npm run test:legacy --prefix web && npm test --prefix frontend",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:e2e": "npm run test:e2e --prefix frontend",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "contract:check": "redocly lint docs/api/openapi.yaml",
    "lint": "eslint web/src frontend/src packages/contracts/src tests"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@redocly/cli": "^1.34.5",
    "@types/supertest": "^6.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.30",
    "@eslint/js": "^9.29.0",
    "@typescript-eslint/parser": "^8.34.1",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "eslint": "^9.29.0",
    "eslint-plugin-vue": "^10.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.9",
    "typescript": "^5.8.3",
    "vue-eslint-parser": "^10.2.0"
  }
}
