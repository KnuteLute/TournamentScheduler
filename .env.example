NODE_ENV=development
PORT=3000
DB_MODE=postgres
POSTGRES_URL=postgres://tournament_dev:local-only-not-a-deployment-secret@127.0.0.1:54329/tournament_dev
# Vite dev origin; for the production same-origin SPA use the deployed site origin.
API_ORIGIN=http://localhost:5173
# Provide 32+ random bytes encoded as hex or base64url. Required in production.
API_SESSION_HASH_SECRET=
# Use 1 only when deployed behind exactly one verified proxy (e.g. Vercel).
API_TRUSTED_PROXY_HOPS=0
