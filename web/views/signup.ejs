<div class="card" style="max-width: 400px; margin: 0 auto; padding: 20px;">
    <h2 style="text-align: center; color: var(--lfc-red);">Sign Up</h2>
    
    <% if (typeof error !== 'undefined' && error) { %>
        <div style="background-color: #ffcccc; color: #cc0000; padding: 10px; border-radius: 4px; margin-bottom: 15px;">
            <%= error %>
        </div>
    <% } %>

    <form action="/signup" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
        <div>
            <label for="username" style="display: block; margin-bottom: 5px;">Username</label>
            <input type="text" id="username" name="username" class="input-field" required style="width: 100%; padding: 8px;">
        </div>
        <div>
            <label for="password" style="display: block; margin-bottom: 5px;">Password</label>
            <input type="password" id="password" name="password" class="input-field" required minlength="6" style="width: 100%; padding: 8px;">
        </div>
        
        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 10px; margin-top: 10px;">Create Account</button>
    </form>

    <div style="text-align: center; margin-top: 20px;">
        <p>Already have an account? <a href="/login" style="color: var(--lfc-red);">Log in here</a></p>
    </div>
</div>
<div style="text-align: center; margin-top: 20px;">
    <a href="/" class="btn btn-secondary">Back to Home</a>
</div>