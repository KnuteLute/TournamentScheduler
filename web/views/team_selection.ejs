<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h1 style="margin: 0;"><%= title %></h1>
    </div>
</div>

<% if (locals.error) { %>
    <div class="card" style="background: #fee; color: #c00; border: 1px solid #c00;">
        <%= error %>
    </div>
<% } %>

<div class="card" style="margin-top: 20px;">
    <h2>Add New Player</h2>
    <form action="/players/add" method="POST" style="display: flex; gap: 10px;">
        <input type="hidden" name="mode" value="<%= mode %>">
        <input type="text" name="name" placeholder="Player Name" required style="padding: 10px; border-radius: 8px; flex-grow: 1;">
        <button type="submit" class="button" style="padding: 10px 20px;">Add</button>
    </form>
</div>

<div class="card" style="margin-top: 20px;">
    <h2>Select Participants</h2>
    <form action="/play/<%= mode %>/start" method="POST">
        <div class="player-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 15px; margin: 20px 0;">
            <% players.forEach(player => { %>
                <div class="player-checkbox" style="background: rgba(255,255,255,0.1); padding: 15px; border-radius: 10px; cursor: pointer;">
                    <input type="checkbox" name="playerIds" value="<%= player.id %>" id="p-<%= player.id %>" style="width: 20px; height: 20px; vertical-align: middle;">
                    <label for="p-<%= player.id %>" style="margin-left: 10px; font-size: 1.1em;"><%= player.name %></label>
                </div>
            <% }) %>
        </div>
        <button type="submit" class="nav-button" style="width: 100%;">Start Tournament</button>
    </form>
</div>
<div style="margin-top: 20px; text-align: center;">
    <a href="/play" class="button" style="background: var(--liverpool-grey);">Back</a>
</div>
