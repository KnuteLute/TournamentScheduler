<div class="card">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h1 style="margin: 0;"><%= title %></h1>
    </div>
</div>

<% if (locals.error) { %>
    <div class="card" style="background: #fee; color: #c00; border: 1px solid #c00;">
        <%= error %>
    </div>
<% } %>

<div class="card" style="margin-top: 20px;">
    <h2>Legg til ny spiller</h2>
    <form id="add-player-form" style="display: flex; gap: 10px;">
        <input type="text" name="name" id="new-player-name" placeholder="Spillernavn" required style="padding: 10px; border-radius: 8px; flex-grow: 1;">
        <button type="submit" class="button" style="padding: 10px 20px;" id="add-player-btn">Legg til</button>
    </form>
</div>

<div class="card" style="margin-top: 20px;">
    <h2>Velg deltakere</h2>
    <form action="/play/<%= mode %>/start" method="POST">
        <div class="player-grid" id="player-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 15px; margin: 20px 0;">
            <% players.forEach(player => { %>
                <div class="player-checkbox" style="background: rgba(255,255,255,0.1); padding: 15px; border-radius: 10px; cursor: pointer;">
                    <input type="checkbox" name="playerIds" value="<%= player.id %>" id="p-<%= player.id %>" style="width: 20px; height: 20px; vertical-align: middle;">
                    <label for="p-<%= player.id %>" style="margin-left: 10px; font-size: 1.1em;"><%= player.name %></label>
                </div>
            <% }) %>
        </div>
        <button type="submit" class="nav-button" style="width: 100%;">Start turnering</button>
    </form>
</div>
<div style="margin-top: 20px; text-align: center;">
    <a href="/play" class="button" style="background: var(--liverpool-grey);">Tilbake</a>
</div>

<script>
document.getElementById('add-player-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('add-player-btn');
    const input = document.getElementById('new-player-name');
    const name = input.value.trim();
    if (!name) return;

    btn.disabled = true;
    btn.textContent = 'Legger til...';

    try {
        const res = await fetch('/api/players/add', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name })
        });

        if (res.ok) {
            const data = await res.json();
            if (data.success && data.player) {
                const grid = document.getElementById('player-grid');
                const div = document.createElement('div');
                div.className = 'player-checkbox';
                div.style.cssText = 'background: rgba(255,255,255,0.1); padding: 15px; border-radius: 10px; cursor: pointer;';
                div.innerHTML = `
                    <input type="checkbox" name="playerIds" value="${data.player.id}" id="p-${data.player.id}" style="width: 20px; height: 20px; vertical-align: middle;" checked>
                    <label for="p-${data.player.id}" style="margin-left: 10px; font-size: 1.1em;">${data.player.name}</label>
                `;
                grid.appendChild(div);
                input.value = '';
            } else if (res.status === 409) {
                const data = await res.json();
                alert(data.error || 'Spilleren finnes allerede.');
            }
        } else {
            const data = await res.json().catch(() => null);
            alert(data?.error || 'Kunne ikke legge til spiller.');
        }
    } catch (err) {
        console.error(err);
        alert('Feil ved håndtering av spilleren.');
    } finally {
        btn.disabled = false;
        btn.textContent = 'Legg til';
    }
});
</script>
