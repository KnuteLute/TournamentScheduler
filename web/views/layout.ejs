<!DOCTYPE html>
<html lang="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : '' %> - Edvins Shuffleboard</title>
    <link rel="stylesheet" href="/liverpool-theme.css">
</head>
<body class="liverpool-theme">
    <div class="container">
        <% if (typeof hideHeader === 'undefined' || !hideHeader) { %>
        <header class="header" style="text-align: center; margin-bottom: 20px; position: relative;">
            <div style="position: absolute; right: 0; top: 0; padding: 10px;">
                <% if (typeof user !== 'undefined' && user) { %>
                    <span>Hei, <%= user.username %></span>
                    <form action="/logout" method="POST" style="display:inline; margin-left: 10px;">
                        <button type="submit" class="btn btn-secondary" style="padding: 5px 10px; font-size: 0.8rem;">Logg ut</button>
                    </form>
                <% } else { %>
                    <a href="/login" class="btn btn-secondary" style="padding: 5px 10px; font-size: 0.8rem;">Logg inn</a>
                    <a href="/signup" class="btn btn-primary" style="padding: 5px 10px; font-size: 0.8rem; margin-left: 5px;">Registrer deg</a>
                <% } %>
            </div>
            <h1>🏆 Edvins Shuffleboard 🏆</h1>
            <p>You'll Never Walk Alone</p>
        </header>
        <% } %>
        
        <main>
            <%- body %>
        </main>
        
        <footer style="text-align: center; margin-top: 40px; padding: 20px; opacity: 0.8;">
            <p>&copy; 2025 Edvins Shuffleboard - Inspirert av Liverpool FC</p>
        </footer>
    </div>
</body>
</html>