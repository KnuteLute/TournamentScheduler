{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "src/app.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["views/**", "public/**"]
      }
    },
    {
      "src": "../frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "npm run build -- --base=/app/",
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "^/api(?:/.*)?$",
      "dest": "src/app.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/app/assets/(.*)$",
      "dest": "/assets/$1"
    },
    {
      "src": "^/app(?:/.*)?$",
      "dest": "/index.html"
    },
    {
      "src": "^/(.*)$",
      "dest": "src/app.ts"
    }
  ]
}
