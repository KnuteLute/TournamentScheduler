{
  "version": 2,
  "builds":[
    {
      "src": "src/app.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles":["views/**", "public/**"]
      }
    }
  ],
  "routes":[
    {
      "src": "/liverpool-theme.css",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/liverpool-theme.css"
    },
    {
      "src": "/(.*)",
      "dest": "src/app.ts"
    }
  ]
}